# Environment Variables for Softhe.io React App
# Copy this file to .env and fill in your actual values

# Google Analytics
# Get your GA4 Measurement ID from: https://analytics.google.com/
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# API Configuration (leave blank for same-origin /api functions)
# VITE_API_URL=https://api.softhe.io
# VITE_API_TIMEOUT=5000

# Application Settings
VITE_APP_NAME=Softhe.io
VITE_APP_URL=https://softhe.io
VITE_SUPPORT_EMAIL=support@softhe.io
VITE_ENVIRONMENT=production
VITE_COMMERCE_ENABLED=false
VITE_CONTACT_FORM_ENABLED=false
# Set to true in the serverless production deployment only after every required
# public and server variable has been configured and /api/health reports ready.
VITE_REQUIRE_PRODUCTION_CONFIG=false
VITE_LEGAL_NAME=Your legal business or personal name
VITE_LEGAL_ADDRESS=Street and number, postal code, city, country
VITE_BUSINESS_REGISTRATION_ID=Swedish organisation number
VITE_LEGAL_JURISDICTION=Sweden
# Use registered, not-registered, or exempt. Add VITE_VAT_ID when registered.
VITE_VAT_STATUS=registered
# VITE_VAT_ID=SE000000000001
# VITE_EDITORIAL_RESPONSIBLE_NAME=Responsible person's full legal name
# VITE_DISPUTE_AUTHORITY=Competent authority or dispute body, when required
# VITE_DISPUTE_AUTHORITY_URL=https://authority.example

# Benchmark methodology. Strict launch builds require real, published values,
# at least three repeated runs, and median aggregation.
VITE_BENCHMARK_HARDWARE=CPU, GPU, motherboard, memory, storage, cooling and display
VITE_BENCHMARK_SOFTWARE=Windows editions/builds, BIOS, chipset and GPU driver, game build
VITE_BENCHMARK_SCENARIO=Resolution, graphics settings, map or benchmark, warm-up and capture duration
VITE_BENCHMARK_CAPTURE_DATE=YYYY-MM-DD
VITE_BENCHMARK_RUN_COUNT=3
VITE_BENCHMARK_SUMMARY_METHOD=median

# Feature Flags
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_ERROR_REPORTING=true

# Development Settings
# VITE_DEV_MODE=true
# VITE_LOG_LEVEL=debug

# Social Media Links
VITE_TWITTER_URL=https://x.com/SoftheCS
VITE_DISCORD_URL=https://discord.com/users/softhecs
VITE_GITHUB_URL=https://github.com/Softhe
VITE_YOUTUBE_URL=https://www.youtube.com/@softhe

# Error Monitoring (Optional HTTPS JSON endpoint)
VITE_ERROR_REPORTING_ENDPOINT=/api/browser-errors

# IMPORTANT NOTES:
# - Never commit the actual .env file to version control
# - Only expose VITE_ prefixed variables to the client
# - Configure server-only values from ../docs/DEPLOYMENT.md in the deployment platform
# - Use different values for development and production environments
