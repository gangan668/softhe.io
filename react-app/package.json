{
	"name": "react-app",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"prebuild": "node scripts/validate-production-config.js && node scripts/validate-server-config.js",
		"build": "vite build && node scripts/postbuild.js && node scripts/scan-secrets.js",
		"security:scan": "node scripts/scan-secrets.js",
		"lint": "eslint .",
		"preview": "vite preview",
		"test": "vitest",
		"test:database": "node ../supabase/tests/run-customer-security.mjs",
		"test:ui": "vitest --ui",
		"test:coverage": "vitest --coverage",
		"audit:ci": "npm audit --audit-level=high",
		"e2e": "node scripts/run-e2e.js enabled",
		"e2e:disabled": "node scripts/run-e2e.js disabled",
		"e2e:portal": "node scripts/run-e2e.js portal",
		"e2e:all": "npm run e2e && npm run e2e:disabled && npm run e2e:portal",
		"benchmark:verify": "node scripts/validate-benchmark-evidence.js",
		"benchmark:frametimes": "node scripts/derive-benchmark-frametimes.js",
		"evidence:verify": "node scripts/validate-launch-evidence.js",
		"smoke:production": "node scripts/production-smoke.js",
		"smoke:browser": "node scripts/production-browser-smoke.js",
		"budget": "node scripts/check-performance-budget.js",
		"test:coverage:inventory": "vitest --run --coverage --config vite.inventory.config.js"
	},
	"dependencies": {
		"@fontsource-variable/inter": "5.3.0",
		"@marsidev/react-turnstile": "1.6.3",
		"@supabase/auth-js": "2.118.0",
		"@supabase/postgrest-js": "2.118.0",
		"@vercel/analytics": "2.0.1",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"wouter": "3.13.0"
	},
	"devDependencies": {
		"@electric-sql/pglite": "0.3.14",
		"@eslint/js": "10.0.1",
		"@playwright/test": "1.64.1",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@testing-library/user-event": "^14.6.8",
		"@vitejs/plugin-react": "^5.0.4",
		"@vitest/coverage-v8": "4.1.12",
		"@vitest/ui": "4.1.12",
		"eslint": "10.13.0",
		"eslint-plugin-react-hooks": "7.1.1",
		"eslint-plugin-react-refresh": "0.5.7",
		"globals": "^16.4.0",
		"jsdom": "^25.0.1",
		"vite": "7.3.7",
		"vitest": "4.1.12"
	}
}
