# Existing commerce variables remain required; see docs/DEPLOYMENT.md.

# Customer portal (server-side)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SERVER_ONLY_SECRET
ADMIN_EMAIL_ALLOWLIST=admin@softhe.io
PORTAL_RATE_LIMIT_SECRET=REPLACE_WITH_RANDOM_SECRET
CHECKOUT_RECEIPT_SECRET=REPLACE_WITH_RANDOM_SECRET
PORTAL_ENABLED=false
NOTIFICATIONS_ENABLED=false
EMAILJS_TICKET_TEMPLATE_ID=REPLACE_ME

# Preview-only fulfillment test receiver
FULFILLMENT_TEST_MODE=false
FULFILLMENT_TEST_FAIL_FIRST=false
FULFILLMENT_TEST_RETENTION_DAYS=30
FULFILLMENT_TEST_EVIDENCE_TOKEN=REPLACE_WITH_RANDOM_SECRET
ORDER_FULFILLMENT_BYPASS_SECRET=REPLACE_WITH_VERCEL_PREVIEW_BYPASS_SECRET

# Bot protection (server-side; pairs with VITE_CAPTCHA_ENABLED / VITE_TURNSTILE_SITE_KEY)
TURNSTILE_SECRET_KEY=REPLACE_WITH_SERVER_ONLY_SECRET

# Detailed /api/health access for release gates and monitoring (also a GitHub Actions secret)
HEALTH_CHECK_TOKEN=REPLACE_WITH_RANDOM_SECRET
